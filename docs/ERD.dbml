
// LaporRT Database Design
// Source of truth: docs/ERD.dbml

Table admins {
  id bigint [pk, increment]
  full_name varchar(120) [not null]
  email varchar(254) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, note: 'CHAIRPERSON or SECRETARY']
  is_active boolean [not null, default: true]
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Akun pengurus RT. Akun dinonaktifkan melalui is_active, bukan dihapus.'
}

Table complaints {
  id bigint [pk, increment]
  ticket_number varchar(32) [not null, unique]
  tracking_code_hash varchar(64) [not null, unique]

  reporter_name varchar(100) [not null]
  reporter_phone varchar(20)

  category varchar(40) [not null]
  urgency varchar(20) [not null, default: 'NORMAL', note: 'NORMAL, HIGH, URGENT']

  subject varchar(150) [not null]
  description varchar(2000) [not null]
  incident_location varchar(500) [not null]

  status varchar(20) [not null, default: 'OPEN', note: 'OPEN, IN_PROGRESS, RESOLVED, REJECTED']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz

  indexes {
    (status, created_at) [name: 'idx_complaints_status_created']
    (created_at) [name: 'idx_complaints_created']
  }

  Note: 'Data utama pengaduan warga. Kode pelacakan asli tidak disimpan, hanya SHA-256 hash.'
}

Table complaint_attachments {
  id bigint [pk, increment]
  complaint_id bigint [not null]
  storage_key varchar(255) [not null, unique]
  original_file_name varchar(255) [not null]
  content_type varchar(100) [not null]
  file_size_bytes bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (complaint_id) [name: 'idx_attachments_complaint']
  }

  Note: 'Menyimpan metadata foto. File fisik berada di private storage, bukan di database.'
}

Table complaint_status_histories {
  id bigint [pk, increment]
  complaint_id bigint [not null]
  changed_by_admin_id bigint
  actor_type varchar(10) [not null, note: 'PUBLIC or ADMIN']

  old_status varchar(20)
  new_status varchar(20) [not null]
  public_message varchar(1000)

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (complaint_id, created_at) [name: 'idx_histories_complaint_created']
  }

  Note: 'Riwayat pertama dibuat otomatis ketika pengaduan masuk: actor_type PUBLIC, changed_by_admin_id NULL.'
}

Ref: complaints.id < complaint_attachments.complaint_id [delete: restrict]

Ref: complaints.id < complaint_status_histories.complaint_id [delete: restrict]

Ref: admins.id < complaint_status_histories.changed_by_admin_id [delete: restrict]
